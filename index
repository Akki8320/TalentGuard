            const slotsContainer = document.getElementById('scheduler-slots');

            title.innerText = `1on1 with ${role}`;

            // Generate some dummy slots
            const slots = ["10:00 AM", "1:30 PM", "3:00 PM", "4:30 PM"];
            slotsContainer.innerHTML = '';

            slots.forEach(time => {
