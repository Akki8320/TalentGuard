<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TalentGuard - Executive Command Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Power User Shortcut: Press '/' to focus chat
        document.addEventListener('keydown', (e) => {
            if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
                e.preventDefault();
                toggleChat();
            }
        });

        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        danger: {
                            50: '#fef2f2',
                            600: '#dc2626',
                        },
                        success: {
                            50: '#f0fdf4',
                            600: '#16a34a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans JP', 'sans-serif'],
                        mono: ['Roboto Mono', 'monospace'],
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.3s ease-out',
                        'slide-up': 'slideUp 0.3s ease-out',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(10px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');

        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: 'Inter', sans-serif;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 30px 30px;
            transition: background-color 0.3s, color 0.3s;
        }

        .dark body {
            background-color: #020617;
            color: #f1f5f9;
            background-image: radial-gradient(#1e293b 1px, transparent 1px);
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        .dashboard-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -1px rgb(0 0 0 / 0.05);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .dark .dashboard-card {
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(51, 65, 85, 0.5);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        .dashboard-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 10px 10px -5px rgb(0 0 0 / 0.04);
            transform: translateY(-4px);
        }

        .dark .dashboard-card:hover {
            border-color: #475569;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
        }

        .btn-primary {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            font-weight: 600;
            transition: all 0.2s;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(15, 23, 42, 0.25);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .view-section {
            display: none;
        }

        .view-section.active {
            display: block;
            animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Toast Notification */
        #toast-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 50;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            pointer-events: none;
        }

        .toast {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 1rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 1rem;
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            min-width: 320px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            pointer-events: auto;
        }

        /* Privacy Mode */
        body.privacy-active .sensitive {
            filter: blur(6px);
            transition: filter 0.3s;
            user-select: none;
        }

        body.privacy-active .sensitive:hover {
            filter: blur(3px);
        }

        /* Chat Widget Styles */
        .chat-widget {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 50;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .chat-window {
            width: 350px;
            height: 500px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border-radius: 1rem;
            margin-bottom: 1rem;
            display: none;
            flex-direction: column;
            overflow: hidden;
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            transform-origin: bottom right;
        }

        .chat-window.open {
            display: flex;
        }

        .chat-messages {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
            font-size: 0.875rem;
            background: #f8fafc;
        }

        .chat-input-area {
            padding: 1rem;
            border-top: 1px solid #e2e8f0;
            background: white;
        }

        .chat-msg {
            margin-bottom: 0.75rem;
            max-width: 85%;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            line-height: 1.5;
            font-size: 0.85rem;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .chat-msg.user {
            background: #0f172a;
            color: white;
            margin-left: auto;
            border-bottom-right-radius: 0.25rem;
        }

        .chat-msg.bot {
            background: white;
            color: #334155;
            margin-right: auto;
            border-bottom-left-radius: 0.25rem;
            border: 1px solid #e2e8f0;
        }

        .chat-bold {
            font-weight: 700;
            color: #1e293b;
        }

        .chat-highlight {
            background-color: #e2e8f0;
            padding: 0.1rem 0.3rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-family: monospace;
        }
    </style>
    <style>
        /* Custom Scrollbar for Webkit */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>

<body class="min-h-screen p-8 max-w-7xl mx-auto">

    <!-- Header -->
    <header class="mb-8 flex flex-col md:flex-row md:items-center justify-between border-b border-gray-200 pb-6 gap-4">
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-3 cursor-pointer group" onclick="navigate('dashboard')">
                <!-- Logo: Humans supporting TG -->
                <div
                    class="w-12 h-12 flex items-center justify-center relative group-hover:scale-105 transition-transform">
                    <!-- Conceptual SVG: 3 Abstract People holding up the letters -->
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 36C12 32 16 30 16 30" stroke="#0ea5e9" stroke-width="3" stroke-linecap="round" />
                        <circle cx="10" cy="30" r="3" fill="#0ea5e9" />
                        <path d="M36 36C36 32 32 30 32 30" stroke="#0ea5e9" stroke-width="3" stroke-linecap="round" />
                        <circle cx="38" cy="30" r="3" fill="#0ea5e9" />
                        <path d="M24 38V44" class="stroke-slate-900 dark:stroke-white" stroke-width="3"
                            stroke-linecap="round" />
                        <circle cx="24" cy="34" class="fill-slate-900 dark:fill-white" r="3" />
                        <path d="M10 30C10 30 18 36 24 36C30 36 38 30 38 30" class="stroke-slate-900 dark:stroke-white"
                            stroke-width="2" stroke-linecap="round" />
                        <text x="24" y="24" font-family="Arial, sans-serif" font-weight="900" font-size="20"
                            class="fill-slate-900 dark:fill-white" text-anchor="middle">TG</text>
                    </svg>
                </div>
                <div>
                    <h1
                        class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-none group-hover:text-brand-600 transition-colors">
                        TalentGuard</h1>
                    <div class="flex items-center gap-2">
                        <p class="text-xs text-slate-500 font-medium" data-i18n="tagline">Human Capital Defense Platform
                        </p>
                        <span
                            class="text-[10px] font-bold text-brand-600 bg-brand-50 px-1.5 py-0.5 rounded border border-brand-100">Client:
                            W Corp</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-6">
            <div
                class="flex gap-1 bg-white dark:bg-slate-800 p-1 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm">
                <button onclick="setLang('en')"
                    class="px-3 py-1 rounded text-xs font-semibold lang-btn transition-colors" id="btn-en">EN</button>
                <button onclick="setLang('ja')"
                    class="px-3 py-1 rounded text-xs font-semibold lang-btn bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white transition-colors"
                    id="btn-ja">日本語</button>
            </div>

            <div class="h-8 w-px bg-gray-200 hidden md:block"></div>

            <button onclick="toggleTheme()"
                class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
                title="Toggle War Room Mode">
                <i data-lucide="moon" class="w-5 h-5" id="theme-icon"></i>
            </button>

            <button onclick="togglePrivacy()"
                class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
                title="Toggle Executive Privacy Mode">
                <i data-lucide="eye" class="w-5 h-5" id="privacy-icon"></i>
            </button>

            <div class="flex gap-6 items-center">
                <!-- Defense Progress Widget -->
                <div class="hidden lg:flex gap-4 mr-4 bg-slate-100 dark:bg-slate-800 p-2 rounded-lg">
                    <div class="text-xs">
                        <span class="block text-slate-400 font-bold uppercase text-[10px]">Active Defense</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300"
                            id="widget-intervention-count">--</span>
                    </div>
                    <div class="w-px bg-slate-300 dark:bg-slate-600"></div>
                    <div class="text-xs">
                        <span class="block text-slate-400 font-bold uppercase text-[10px]">Resolved</span>
                        <span class="font-bold text-emerald-600 dark:text-emerald-400"
                            id="widget-resolved-count">--</span>
                    </div>
                </div>

                <div class="text-right hidden md:block">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"
                        data-i18n="activeHeadcount">Active Employees</div>
                    <div class="text-2xl font-bold text-slate-700 dark:text-slate-200 font-mono leading-none sensitive">
                        1,470</div>
                </div>
                <div class="text-right cursor-pointer" onclick="navigate('detail-risk')" title="View details">
                    <div
                        class="text-[10px] font-bold text-danger-600 uppercase tracking-wider flex items-center justify-end gap-1">
                        <span class="w-2 h-2 rounded-full bg-danger-600 animate-pulse"></span> <span
                            data-i18n="riskAlert">Risk Alert</span>
                    </div>
                    <div class="text-2xl font-bold text-danger-600 font-mono leading-none group-hover:underline"
                        id="header-risk-count">--</div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Dashboard View -->
    <main id="view-dashboard" class="view-section active">
        <!-- Hero KPI -->
        <section class="mb-8">
            <div
                class="dashboard-card p-8 flex flex-col md:flex-row items-center justify-between bg-white overflow-hidden relative group">
                <div
                    class="absolute top-0 right-0 w-64 h-64 bg-brand-50 rounded-bl-full -z-10 opacity-50 group-hover:scale-110 transition-transform duration-500">
                </div>

                <div class="mb-6 md:mb-0 relative z-10">
                    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2 flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-500"></i> <span
                            data-i18n="savedAssetValue">Saved Asset Value (YTD)</span>
                    </h2>
                    <div class="text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-brand-700 to-brand-500 dark:text-white dark:bg-none mb-2 font-mono tracking-tighter sensitive"
                        id="hero-value">
                        $60,000,000
                    </div>
                    <div
                        class="flex items-center gap-2 mt-4 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 inline-flex px-3 py-1.5 rounded-full border border-slate-100 dark:border-slate-700">
                        <span data-i18n="preventedText">Prevented <strong>5</strong> high-value attritions this
                            month.</span>
                    </div>
                </div>

                <div
                    class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm px-8 py-6 rounded-2xl border border-brand-100 dark:border-slate-700 shadow-lg shadow-brand-100/50 dark:shadow-none max-w-xs w-full hover:scale-105 transition-transform duration-300">
                    <p class="text-brand-900 dark:text-brand-300 text-xs font-bold uppercase mb-2 tracking-widest"
                        data-i18n="roiImpact">ROI
                        Impact</p>
                    <div
                        class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-400 dark:from-brand-400 dark:to-brand-200 mb-2">
                        +124%</div>
                    <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-medium"
                        data-i18n="roiDesc">
                        Early intervention preserved critical intellectual capital.
                    </p>
                </div>
            </div>
        </section>

        <!-- Engines Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- Card 1: Predictive Analytics -->
            <div class="dashboard-card p-6 flex flex-col h-full cursor-pointer group" onclick="navigate('detail-risk')">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 bg-red-50 rounded-lg text-red-600 group-hover:bg-red-100 transition-colors">
                        <i data-lucide="activity" class="w-6 h-6"></i>
                    </div>
                    <div class="px-2 py-1 bg-gray-100 dark:bg-slate-700 rounded text-[10px] font-bold text-gray-500 dark:text-slate-300 uppercase"
                        data-i18n="inputCsv">Input: CSV
                    </div>
                </div>
                <h3 class="font-bold text-lg text-slate-800 dark:text-slate-100" data-i18n="engine1Title">Predictive
                    Analytics</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6" data-i18n="engine1Desc">AI-driven early
                    warning system for
                    attrition risk.</p>

                <div class="space-y-2 mb-6 flex-1 h-32 relative">
                    <canvas id="chart-attrition"></canvas>
                </div>
                <button
                    class="w-full py-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-sm font-medium group-hover:bg-brand-50 dark:group-hover:bg-brand-900/30 group-hover:text-brand-700 dark:group-hover:text-brand-400 group-hover:border-brand-200 dark:group-hover:border-brand-800 transition-all"
                    data-i18n="viewDetails">View Analysis</button>
            </div>

            <!-- Card 2: Recruitment Simulation -->
            <div class="dashboard-card p-6 flex flex-col h-full cursor-pointer group" onclick="navigate('detail-roi')">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 bg-blue-50 rounded-lg text-blue-600 group-hover:bg-blue-100 transition-colors">
                        <i data-lucide="pie-chart" class="w-6 h-6"></i>
                    </div>
                    <div class="px-2 py-1 bg-gray-100 dark:bg-slate-700 rounded text-[10px] font-bold text-gray-500 dark:text-slate-300 uppercase"
                        data-i18n="inputChannel">Input:
                        Channel</div>
                </div>
                <h3 class="font-bold text-lg text-slate-800 dark:text-slate-100" data-i18n="engine2Title">Recruitment
                    Simulation</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6" data-i18n="engine2Desc">Maximize capital
                    efficiency & LTV
                    optimization.</p>

                <div class="space-y-2 mb-6 flex-1 h-32 relative">
                    <canvas id="chart-roi"></canvas>
                </div>
                <button
                    class="w-full py-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-sm font-medium group-hover:bg-brand-50 dark:group-hover:bg-brand-900/30 group-hover:text-brand-700 dark:group-hover:text-brand-400 group-hover:border-brand-200 dark:group-hover:border-brand-800 transition-all"
                    data-i18n="viewDetails">View Analysis</button>
            </div>

            <!-- Card 3: Reward Optimization -->
            <div class="dashboard-card p-6 flex flex-col h-full cursor-pointer group"
                onclick="navigate('detail-reward')">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 bg-amber-50 rounded-lg text-amber-600 group-hover:bg-amber-100 transition-colors">
                        <i data-lucide="scale" class="w-6 h-6"></i>
                    </div>
                    <div class="px-2 py-1 bg-gray-100 dark:bg-slate-700 rounded text-[10px] font-bold text-gray-500 dark:text-slate-300 uppercase"
                        data-i18n="inputAction">Action
                    </div>
                </div>
                <h3 class="font-bold text-lg text-slate-800 dark:text-slate-100" data-i18n="engine3Title">Total Reward
                    Optimization</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6" data-i18n="engine3Desc">Synchronize
                    organizational & individual
                    interests.</p>

                <div
                    class="bg-amber-50 dark:bg-amber-900/20 border border-amber-100 dark:border-amber-800 rounded p-3 mb-6 flex-1">
                    <div class="flex gap-2 mb-1">
                        <i data-lucide="zap" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
                        <span class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase">Opportunity</span>
                    </div>
                    <p class="text-xs text-amber-700 dark:text-amber-200 leading-tight">
                        Grant <strong>100 SO</strong> to #152 to boost retention by 90%.
                    </p>
                </div>
                <button
                    class="w-full py-2 bg-slate-900 border border-slate-900 text-white rounded-lg text-sm font-medium group-hover:bg-slate-800 transition-all shadow-lg shadow-slate-900/10"
                    data-i18n="openOptimizer">Open Optimizer</button>
            </div>

        </div>
    </main>

    <!-- Detail View: Risk Forecast -->
    <section id="view-detail-risk" class="view-section">
        <button onclick="navigate('dashboard')"
            class="mb-6 flex items-center text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4 mr-1"></i> <span data-i18n="back">Back to Dashboard</span>
        </button>

        <div class="dashboard-card p-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white" data-i18n="riskDetailTitle">Attrition
                        Risk Analysis
                    </h2>
                    <p class="text-slate-500 dark:text-slate-400" data-i18n="riskDetailDesc">Real-time scoring based on
                        Inequity Index and
                        behavioral logs.</p>
                </div>
                <div class="flex gap-2">
                    <select id="dept-filter" onchange="filterRiskTable()"
                        class="btn-secondary text-sm bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 text-slate-700 dark:text-slate-300">
                        <option value="all">All Departments</option>
                        <option value="Sales">Sales</option>
                        <option value="R&D">R&D</option>
                        <option value="Tech">Tech</option>
                    </select>
                    <button class="btn-primary flex items-center gap-2"
                        onclick="showToast('Exporting CSV...', 'success')"><i data-lucide="download"
                            class="w-4 h-4"></i> Export CSV</button>
                </div>
            </div>
        </div>

        <!-- Organizational Health Matrix -->
        <div class="mb-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div
                class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-700 p-6 shadow-sm">
                <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-4 flex items-center gap-2">
                    <i data-lucide="scatter-chart" class="w-5 h-5 text-brand-500"></i>
                    Organizational Health Map
                </h3>
                <div class="h-64 relative">
                    <canvas id="chart-org-health"></canvas>
                </div>
            </div>
            <div class="bg-gradient-to-br from-brand-900 to-slate-900 rounded-xl p-6 text-white shadow-lg">
                <h3 class="font-bold text-lg mb-2">Health Insights</h3>
                <div class="space-y-4">
                    <div class="bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                        <div class="text-xs text-brand-200 uppercase font-bold mb-1">High Risk Area</div>
                        <div class="font-bold">Sales Dept</div>
                        <div class="text-xs text-gray-300 mt-1">High "Unfairness" correlates with 40% attrition risk.
                        </div>
                    </div>
                    <div class="bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                        <div class="text-xs text-emerald-200 uppercase font-bold mb-1">Stable Area</div>
                        <div class="font-bold">Tech Dept</div>
                        <div class="text-xs text-gray-300 mt-1">Remote work options suppressed turnover despite high OT.
                        </div>
                    </div>
                </div>
            </div>
