            document.getElementById('sim-savings').innerText = `$${savings.toLocaleString()}`;

            // Retention: 0.15% per 1% shift
            const retention = (percentage * 0.15).toFixed(1);
            document.getElementById('sim-retention').innerText = `+${retention}%`;
        }

