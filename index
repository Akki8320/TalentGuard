        }

        function handleChatKey(e) {
            if (e.key === 'Enter') sendChat();
        }

        function sendChat() {
            const input = document.getElementById('chat-input');
            const msg = input.value.trim();
            if (!msg) return;

            // Add User Message
            appendMsg(msg, 'user');
            input.value = '';

            // Loading state
            setTimeout(() => {
                const response = getBotResponse(msg);
                appendMsg(response, 'bot');
            }, 600);
        }

        function appendMsg(text, sender) {
            const div = document.createElement('div');
            div.className = `chat-msg ${sender}`;
            div.innerHTML = text; // Allow bolding
            const container = document.getElementById('chat-messages');
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function getBotResponse(input) {
            const lower = input.toLowerCase();
            if (lower.includes('risk') || lower.includes('attrition') || lower.includes('predict')) {
                return "<span class='chat-bold'>Predictive Analytics:</span> W Company data analysis reveals 12 high-risk employees. <span class='chat-highlight'>Inequity Index</span> shows a major gap in the Sales Dept.";
            }
            if (lower.includes('roi') || lower.includes('recruit') || lower.includes('hiring')) {
                return "<span class='chat-bold'>Recruitment Simulation:</span> 'Intern' & 'New Grad' channels are stable, but 'Direct Recruiting' yields 15% higher LTV. Recommendation: Shift budget from Agent B.";
            }
            if (lower.includes('reward') || lower.includes('compensation') || lower.includes('salary')) {
                return "<span class='chat-bold'>Total Reward Optimization:</span> Propose Stock Option grant for 3 top performers at W Company to align interests.";
            }
            if (lower.includes('hello') || lower.includes('hi')) {
                return "Hello. I am TalentCopilot, dedicated to W Corp's defense. I am monitoring the <span class='chat-highlight'>Inequity Index</span> and <span class='chat-highlight'>LTV Scenarios</span>. What would you like to know?";
            }
            return "I can simulate outcomes for <span class='chat-bold'>Attrition Risk</span>, <span class='chat-bold'>Recruitment ROI</span>, or <span class='chat-bold'>Reward Strategy</span>. Please specify your intent.";
        }
        // 8. Analysis Modal Logic
        let currentEmpId = null;
        let simSalary = 0;
        let simOt = 0;

        function openAnalysisModal(id) {
            const emp = risks.find(r => r.id === id);
            if (!emp) return;
            currentEmpId = id;

            // Populate Header
            document.getElementById('modal-emp-role').innerText = emp.role;
            document.getElementById('modal-emp-id').innerText = '#' + emp.id;
            document.getElementById('modal-emp-dept').innerText = emp.dept;
            document.getElementById('modal-risk-score').innerText = emp.risk + '%';

            // Reset Simulation
            simSalary = 0;
            simOt = 0;
            updatePersonalSimulation(0, 'init'); // Reset UI

            // Render XAI
            const container = document.getElementById('xai-container');
            container.innerHTML = '';

            // Convert to array and sort by absolute impact
            const entries = Object.entries(emp.xai || {});
            // Find max value to normalize width
            const maxVal = Math.max(...entries.map(e => Math.abs(e[1])), 60);

            entries.forEach(([key, val]) => {
                const isNegative = val < 0; // Negative value = Risk Factor (Red)
                const isPositive = val > 0; // Positive value = Retention Factor (Green)
                const width = (Math.abs(val) / maxVal) * 100;

                const barHtml = `
                    <div class="mb-3">
                        <div class="flex justify-between text-xs font-bold mb-1 items-center">
                            <span class="${isNegative ? 'text-red-600' : 'text-emerald-500'}">${key}</span>
                            <span class="text-slate-400">${isPositive ? '+' : ''}${val} impact</span>
                        </div>
                        <div class="flex items-center gap-1 h-3">
                            <!-- Left (Green) -->
                            <div class="flex-1 flex justify-end">
                                ${isPositive ? `<div class="h-full bg-emerald-400 rounded-l-sm" style="width: ${width}%"></div>` : ''}
                            </div>
                            <!-- Center Line -->
                            <div class="w-0.5 h-4 bg-slate-300 dark:bg-slate-600"></div>
                            <!-- Right (Red) -->
                            <div class="flex-1 flex justify-start">
                                ${isNegative ? `<div class="h-full bg-red-400 rounded-r-sm" style="width: ${width}%"></div>` : ''}
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += barHtml;
            });

            // Render Playbook
            const playbookList = document.getElementById('playbook-content');
            playbookList.innerHTML = '';

            const strategies = {
                "Pay Gap": "Acknowledge the gap. Discuss non-monetary perks (flexibility, remote work) or outline a clear path/milestones for a salary review.",
                "Stress": "Ask: 'What creates the most friction in your day?' Offer to offload 1 administrative task immediately.",
                "Role Stagnation": "Propose a '20% project' outside their core role. Ask: 'What skill do you want to master this quarter?'",
                "Overtime": "Review workload distribution. Verify if 'urgent' tasks are truly urgent. Mandate a 'no-meeting Friday'.",
                "Environment": "Discuss team dynamics. Ask: 'Who do you go to when you're stuck?' to gauge psychological safety.",
                "Incentive Drop": "Explain the calculation transparently. Focus on what *is* controllable for next quarter.",
                "Low Perf": "Clarify expectations. Ask: 'Do you have the tools you need?' Switch from 'judging' to 'coaching'.",
                "Commute": "Discuss hybrid options or flexible start times to avoid peak traffic."
            };

            const defaultTip = "Ask: 'On a scale of 1-10, how sustainable does your current work pace feel?'";

            // Add specific tips
            let hasSpecific = false;
            (emp.factors || []).forEach(f => {
                if (strategies[f] || strategies[f.split(' ')[0]]) { // specialized or broad match
                    // Simple matching logic
                    const key = strategies[f] ? f : Object.keys(strategies).find(k => f.includes(k));
                    if (key) {
                        playbookList.innerHTML += `<li class="mb-2"><strong>${f}:</strong> ${strategies[key]}</li>`;
                        hasSpecific = true;
                    }
                }
            });

            if (!hasSpecific) {
                playbookList.innerHTML += `<li class="mb-2"><strong>Check-in:</strong> ${defaultTip}</li>`;
            }
            // Always add a closing positive note
            playbookList.innerHTML += `<li><strong>Closing:</strong> "I value your contribution to [Project/Team]. Let's revisit this in 2 weeks."</li>`;

            // Show Modal
            const modal = document.getElementById('analysis-modal');
            modal.classList.remove('hidden');
        }

        function closeAnalysisModal() {
            document.getElementById('analysis-modal').classList.add('hidden');
        }

        function updatePersonalSimulation(val, type) {
            if (type === 'salary') simSalary = parseInt(val);
            if (type === 'ot') simOt = parseInt(val);

            // Update UI Labels
            const salaryLabel = simSalary > 0 ? `+¥${simSalary.toLocaleString()}` : "+0";
            document.getElementById('sim-salary-val').innerText = salaryLabel;
            document.getElementById('sim-ot-val').innerText = `-${simOt}h`;

            // Calculate New Risk
            const emp = risks.find(r => r.id === currentEmpId);
            if (!emp) return;

            // Simple Model: +10k salary = -2% risk, -1h OT = -1% risk
            const riskReduction = Math.floor((simSalary / 5000) * 1.5) + (simOt * 1.2);
            let newRisk = Math.max(0, emp.risk - riskReduction);

            // Visual Updates
            const riskEl = document.getElementById('sim-new-risk');
            riskEl.innerText = newRisk.toFixed(1) + '%';

            // Color coding
            if (newRisk < 50) riskEl.className = "text-3xl font-bold transition-all text-emerald-600";
            else if (newRisk < 70) riskEl.className = "text-3xl font-bold transition-all text-amber-500";
            else riskEl.className = "text-3xl font-bold transition-all text-red-600";

            document.getElementById('sim-risk-delta').innerText = `Risk Reduction: -${riskReduction.toFixed(1)} pts`;
        }

    </script>
